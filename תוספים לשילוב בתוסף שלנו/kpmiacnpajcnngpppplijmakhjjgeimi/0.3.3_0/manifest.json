{
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "global.css", "content.css" ],
      "js": [ "content.js" ],
      "matches": [ "https://*.youtube.com/*" ],
      "run_at": "document_start"
   } ],
   "description": "Get lyrics for any music video on YouTube.",
   "host_permissions": [ "https://*.youtube.com/", "https://open.spotify.com/get_access_token", "https://spclient.wg.spotify.com/", "https://api-partner.spotify.com/" ],
   "icons": {
      "128": "img/icon_128.png",
      "16": "img/icon_16.png",
      "32": "img/icon_32.png",
      "48": "img/icon_48.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "93",
   "name": "YouTube Lyrics",
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.3.3",
   "web_accessible_resources": [ {
      "matches": [ "https://*.youtube.com/*" ],
      "resources": [ "fonts/*", "get-video-info.js" ]
   } ]
}

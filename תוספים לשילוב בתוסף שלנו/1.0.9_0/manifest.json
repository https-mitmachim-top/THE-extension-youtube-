{
   "action": {
      "default_icon": {
         "128": "icon128.png",
         "16": "icon16.png",
         "48": "icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "analytics.js", "content.js" ],
      "matches": [ "*://*.youtube.com/*" ],
      "run_at": "document_end"
   } ],
   "description": "✨ Shows real-time synced lyrics on YouTube. A simple YouTube lyrics extension for music videos and songs.",
   "host_permissions": [ "https://www.youtube.com/*", "https://lrclib.net/*", "https://api.lyrics.ovh/*", "https://*.vercel.app/*" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "YouTube Lyrics Extension – Real-Time Synced Lyrics | YT Lyrics",
   "permissions": [ "activeTab", "scripting", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.9"
}
